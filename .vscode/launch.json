{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "App Order Book",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/src/app.py",
        "console": "integratedTerminal",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      {
        "name": "Sim Order Book",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/src/simulator/sim_app.py",
        "console": "integratedTerminal",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
    ],
    "compounds": [
      {
        "name": "Run Sim & App",
        "configurations": ["Order Book Sim", "Order Book App"]
      }
    ]
  }